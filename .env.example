PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finance_app
DATABASE_SYNC=true
DATABASE_LOGGING=false
JWT_SECRET=change-this-in-production-min-32-chars
JWT_EXPIRES_SEC=604800
# Origins permitidas pelo browser (uma URL completa por valor; vírgula ou ; como separador).
# HTTP e HTTPS contam como origens diferentes — inclua a que você usa no painel (ex.: https://...).
# Espaços em volta dos valores são ignorados.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,https://financial.brunoholanda.com

# Seed (apenas quando não existir nenhum MASTER)
MASTER_EMAIL=master@finance.app
MASTER_PASSWORD=Master@123456
MASTER_NAME=Administrador Master
