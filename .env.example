PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finance_app
DATABASE_SYNC=true
DATABASE_LOGGING=false
JWT_SECRET=change-this-in-production-min-32-chars
JWT_EXPIRES_SEC=604800
# Origins permitidas pelo browser (uma URL completa por valor; vírgula ou ; como separador).
# HTTP e HTTPS contam como origens diferentes — inclua a que você usa no painel (ex.: https://...).
# Espaços em volta dos valores são ignorados.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,https://financial.brunoholanda.com

# Rate limit por IP e por endpoint. Duas janelas valem ao mesmo tempo: a curta
# contém rajadas de chamadas simultâneas, a longa contém abuso sustentado.
# Login, cadastro, 2FA, chamados e envios de e-mail têm limites próprios, mais
# baixos, definidos no código. O webhook do Stripe é isento.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST_TTL_SEC=1
RATE_LIMIT_BURST_LIMIT=10
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_LIMIT=120

# Obrigatório atrás de proxy reverso (nginx, Cloudflare, Render): número de
# proxies confiáveis à frente do backend. Sem isso o rate limit conta o IP do
# proxy e trata todos os visitantes como um só. Em execução local, deixe vazio.
# TRUST_PROXY=1

# Documentação pública da API em /docs, /openapi.json e /openapi.yaml, anunciada
# em /.well-known/api-catalog no site. API_PUBLIC_URL é a URL que aparece como
# servidor na especificação. Use API_DOCS_ENABLED=false para desligar.
API_DOCS_ENABLED=true
API_PUBLIC_URL=https://financial.api.brunoholanda.com

# Verificação em duas etapas do login (código de 6 dígitos por e-mail).
# Exige SMTP configurado. Use false apenas em ambiente local sem e-mail.
AUTH_2FA_ENABLED=true
AUTH_2FA_TTL_SEC=600

# Pasta base para arquivos carregados em «Documentos» (opcional). Predefinição: ./uploads na raiz do backend.
# DOCUMENTS_UPLOAD_DIR=D:\\dados\\finance-uploads

# Seed (apenas quando não existir nenhum MASTER)
MASTER_EMAIL=master@finance.app
MASTER_PASSWORD=Master@123456
MASTER_NAME=Administrador Master

# Área de gestão (usuários, chamados e pagamentos): e-mails que recebem a flag
# is_manager na subida do backend. Separe por vírgula. Para remover o acesso,
# desligue is_manager no banco (o .env só liga).
MANAGER_EMAILS=master@finance.app
# Avisos de chamado (abertura e novas mensagens do cliente) sempre enviados a
# estes endereços, além das contas com a flag de gestão. Separe por vírgula.
SUPPORT_ALERT_EMAILS=master@finance.app

# SMTP HostGator (Titan) — envio transacional do app
# 587 + SMTP_SECURE=false (STARTTLS)  |  465 + SMTP_SECURE=true (SSL)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@brunoholanda.com
SMTP_PASS=
MAIL_FROM="App Financeiro <contato@brunoholanda.com>"

# Cron 08:00 America/Sao_Paulo — desative com false
# Destinatário = e-mail do MASTER dono do workspace (createdBy) de cada conta/seguro
BILL_ALERT_CRON_ENABLED=true
INSURANCE_ALERT_CRON_ENABLED=true
# Usada nos e-mails e no retorno do checkout do Stripe (em dev: http://localhost:5173)
APP_PUBLIC_URL=https://financial.brunoholanda.com

# Licença de uso: teste grátis e assinatura mensal
BILLING_TRIAL_DAYS=15
BILLING_PRICE_CENTS=4900
BILLING_CURRENCY=BRL
# Plano padrão inclui até N documentos; acima disso o cliente sobe para o Premium.
BILLING_DOCUMENT_LIMIT=10
# Adicional mensal do Premium (somado a BILLING_PRICE_CENTS = 7800 = R$ 78/mês)
BILLING_PREMIUM_EXTRA_CENTS=2900
# Reconciliação diária (05:00 America/Sao_Paulo) das assinaturas no Stripe
BILLING_SYNC_CRON_ENABLED=true
# Stripe: sem STRIPE_SECRET_KEY o app segue funcionando, mas o checkout fica indisponível.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: preços recorrentes já criados no Stripe. Vazio = preço gerado na hora
# com BILLING_PRICE_CENTS (padrão) e BILLING_PRICE_CENTS + BILLING_PREMIUM_EXTRA_CENTS (Premium).
STRIPE_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
# Meios de pagamento do checkout. Vazio = card (único que cobre assinatura
# mensal em BRL). Só mude se ativar outro meio recorrente no painel.
STRIPE_PAYMENT_METHOD_TYPES=card
